{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "public/ts",
    "outDir": "public/js",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": [],
    "noEmitOnError": true
  },
  "include": ["public/ts/**/*.ts"]
}
